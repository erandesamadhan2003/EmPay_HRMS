			"get": { "tags": ["Attendance"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "OK" } } }
