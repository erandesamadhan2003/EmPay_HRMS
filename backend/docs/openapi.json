{
	"openapi": "3.0.3",
	"info": {
		"title": "EmPay HRMS API",
		"version": "1.0.0",
		"description": "REST API under `/api/*`. JWT: `Authorization: Bearer <token>`."
	},
	"servers": [{ "url": "http://localhost:3000", "description": "Local" }],
	"tags": [
		{ "name": "Auth" },
		{ "name": "Companies" },
		{ "name": "Company requests" },
		{ "name": "Departments" },
		{ "name": "Employees" },
		{ "name": "Attendance" },
		{ "name": "Time off" },
		{ "name": "Salary structures" },
		{ "name": "Payruns" },
		{ "name": "Payslips" },
		{ "name": "Reports" },
		{ "name": "Settings" },
		{ "name": "Dashboard" },
		{ "name": "Audit logs" }
	],
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		}
	},
	"paths": {
		"/api/auth/login": {
			"post": {
				"tags": ["Auth"],
				"summary": "Login",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["login_id", "password"],
								"properties": {
									"login_id": { "type": "string" },
									"password": { "type": "string" }
								}
							}
						}
					}
				},
				"responses": { "200": { "description": "OK" }, "400": { "description": "Bad request" } }
			}
		},
		"/api/auth/register": {
			"post": {
				"tags": ["Auth"],
				"summary": "Register company admin (pending approval)",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["company_id", "name", "email"],
								"properties": {
									"company_id": { "type": "string", "format": "uuid" },
									"name": { "type": "string" },
									"email": { "type": "string" }
								}
							}
						}
					}
				},
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/auth/change-password": {
			"post": {
				"tags": ["Auth"],
				"security": [{ "bearerAuth": [] }],
				"summary": "Change password",
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/auth/logout": {
			"post": {
				"tags": ["Auth"],
				"security": [{ "bearerAuth": [] }],
				"summary": "Logout",
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/auth/refresh": {
			"post": { "tags": ["Auth"], "summary": "Refresh token (stub)", "responses": { "501": { "description": "Not implemented" } } }
		},
		"/api/auth/reset-password": {
			"post": {
				"tags": ["Auth"],
				"security": [{ "bearerAuth": [] }],
				"summary": "Admin reset employee password",
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/companies": {
			"post": {
				"tags": ["Companies"],
				"summary": "Create company",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["name"],
								"properties": { "name": { "type": "string" }, "logoUrl": { "type": "string", "nullable": true } }
							}
						}
					}
				},
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/company-requests": {
			"get": {
				"tags": ["Company requests"],
				"security": [{ "bearerAuth": [] }],
				"summary": "List company requests (superadmin)",
				"parameters": [
					{ "name": "page", "in": "query", "schema": { "type": "integer" } },
					{ "name": "limit", "in": "query", "schema": { "type": "integer" } },
					{ "name": "status", "in": "query", "schema": { "type": "string" } }
				],
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/company-requests/{id}/review": {
			"post": {
				"tags": ["Company requests"],
				"security": [{ "bearerAuth": [] }],
				"summary": "Approve/reject request",
				"parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/departments": {
			"get": {
				"tags": ["Departments"],
				"security": [{ "bearerAuth": [] }],
				"summary": "List departments",
				"responses": { "200": { "description": "OK" } }
			},
			"post": {
				"tags": ["Departments"],
				"security": [{ "bearerAuth": [] }],
				"summary": "Create department",
				"responses": { "201": { "description": "Created" } }
			}
		},
		"/api/departments/{id}": {
			"put": {
				"tags": ["Departments"],
				"security": [{ "bearerAuth": [] }],
				"parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
				"responses": { "200": { "description": "OK" } }
			},
			"delete": {
				"tags": ["Departments"],
				"security": [{ "bearerAuth": [] }],
				"parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/employees": {
			"get": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "summary": "Directory", "responses": { "200": { "description": "OK" } } },
			"post": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "summary": "Create employee", "responses": { "201": { "description": "Created" } } }
		},
		"/api/employees/me": {
			"get": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "summary": "Current user profile", "responses": { "200": { "description": "OK" } } },
			"put": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "summary": "Update self", "responses": { "200": { "description": "OK" } } }
		},
		"/api/employees/{id}": {
			"get": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "OK" } } },
			"put": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "OK" } } },
			"delete": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "OK" } } }
		},
		"/api/employees/{id}/salary": {
			"get": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "OK" } } },
			"put": { "tags": ["Employees"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "OK" } } }
		},
		"/api/attendance/check-in": {
			"post": {
				"tags": ["Attendance"],
				"security": [{ "bearerAuth": [] }],
				"summary": "Check in",
				"description": "If the company has office latitude/longitude set (admin settings), body must include latitude and longitude (WGS84). Server rejects check-in when distance from office exceeds 100m.",
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"description": "WGS84. Prefer numbers from navigator.geolocation: coords.latitude and coords.longitude.",
								"properties": {
									"latitude": { "type": "number", "description": "Device latitude (degrees), same as GeolocationCoordinates.latitude" },
									"longitude": { "type": "number", "description": "Device longitude (degrees), same as GeolocationCoordinates.longitude" },
									"lat": { "type": "number" },
									"lng": { "type": "number" },
									"coords": {
										"type": "object",
										"properties": {
											"latitude": { "type": "number" },
											"longitude": { "type": "number" }
										}
									}
								}
							}
						}
					}
				},
				"responses": {
					"201": { "description": "Created" },
					"400": { "description": "Missing coordinates when geofence enabled" },
					"403": { "description": "Outside geofence radius" }
				}
			}
		},
		"/api/attendance/check-in-policy": {
			"get": {
				"tags": ["Attendance"],
				"security": [{ "bearerAuth": [] }],
				"summary": "Check-in geofence policy",
				"description": "Returns whether coordinates are required and the office anchor for UI (mirror Haversine + 100m to enable the button). Server enforces on POST /attendance/check-in.",
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/api/attendance/check-out": {
			"post": { "tags": ["Attendance"], "security": [{ "bearerAuth": [] }], "summary": "Check out", "responses": { "200": { "description": "OK" } } }
		},
		"/api/attendance/me": {
			"get": { "tags": ["Attendance"], "security": [{ "bearerAuth": [] }], "summary": "My attendance month", "responses": { "200": { "description": "OK" } } }
		},
		"/api/attendance/summary/{userId}": {
			"get": { "tags": ["Attendance"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "OK" } } }
		},
